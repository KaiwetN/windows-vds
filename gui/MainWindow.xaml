                            <CheckBox x:Name="EffectsLightbarCheckBox" Grid.Column="1" Content="自定义"
                                      FontSize="12" Foreground="#475467"
                                      Checked="Effects_ValueChanged" Unchecked="Effects_ValueChanged" />
                        </Grid>
                        <StackPanel x:Name="EffectsLightbarPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="红" Foreground="{StaticResource TextTertiary}" FontSize="12" HorizontalAlignment="Center" />
                                    <Slider x:Name="EffectsLightbarRSlider" Minimum="0" Maximum="255" TickFrequency="5"
                                            ValueChanged="Effects_ValueChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="绿" Foreground="{StaticResource TextTertiary}" FontSize="12" HorizontalAlignment="Center" />
                                    <Slider x:Name="EffectsLightbarGSlider" Minimum="0" Maximum="255" TickFrequency="5"
                                            ValueChanged="Effects_ValueChanged" />
