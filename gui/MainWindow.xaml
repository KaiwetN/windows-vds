<Window x:Class="VdsGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vDS 控制中心"
        Width="1320"
        Height="850"
        MinWidth="960"
        MinHeight="690"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="{StaticResource UiFont}"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!--
            Text roles. The greys these replaced measured 2.6:1 and 3.7:1 on
            white - both under the 4.5:1 WCAG AA floor - and were used almost
            exclusively on 11px Chinese text, where legibility is worst.
        -->
        <SolidColorBrush x:Key="TextPrimary" Color="#172B4D" />
        <SolidColorBrush x:Key="TextSecondary" Color="#4A5A73" />
        <SolidColorBrush x:Key="TextTertiary" Color="#667085" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />

        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--
            DataGridCell.VerticalContentAlignment centres the ContentPresenter,
            but a DataGridTextColumn's generated TextBlock defaults to
            VerticalAlignment=Stretch, so it fills the row and draws its text at
            the top - leaving the text cells sitting above the status pills.
        -->
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="MeterBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#E6EBF3" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="#E5EAF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <!--
                                Hover and press darken with a translucent
                                overlay instead of lowering Opacity, which used
                                to blend the button toward the page background
                                and made hover look disabled.
                            -->
                            <Border x:Name="Overlay" CornerRadius="9"
                                    Background="Transparent" IsHitTestVisible="False" />
                            <Border x:Name="FocusRing" CornerRadius="9"
                                    BorderThickness="2" BorderBrush="Transparent"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#18000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Background" Value="#2E000000" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="#93B4FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8ECF2" />
                                <Setter Property="Foreground" Value="#9AA6B6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="Foreground" Value="#263246" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FDECEC" />
            <Setter Property="Foreground" Value="#B42318" />
        </Style>
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="120" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F5" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="48" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E7EBF1" />
            <Setter Property="Padding" Value="12,0" />
            <!-- Headers follow the centred cell content below them. -->
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EDF4FF" />
                    <Setter Property="Foreground" Value="#172B4D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="108" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,16,16,0" CornerRadius="18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#101A32" Offset="0" />
                    <GradientStop Color="#172F63" Offset="0.64" />
                    <GradientStop Color="#155E75" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="70" Height="70" CornerRadius="20" Background="#22FFFFFF"
                        VerticalAlignment="Center">
                    <Grid>
                        <Ellipse Width="40" Height="25" Stroke="#D9F5FF" StrokeThickness="3" />
                        <Ellipse Width="5" Height="5" Fill="#67E8F9" Margin="-18,0,0,0" />
                        <Ellipse Width="5" Height="5" Fill="#67E8F9" Margin="18,0,0,0" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="vDS 控制中心" Foreground="White" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="BE200 蓝牙 DualSense → 完整虚拟 USB 有线手柄"
                               Foreground="#BFD5F1" FontSize="14" Margin="0,7,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                        Background="#24FFFFFF" Foreground="White" Padding="18,10"
                        VerticalAlignment="Center" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻" FontSize="18" Margin="0,-2,7,0" />
                        <TextBlock Text="刷新状态" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <!--
                    The detail column is fixed rather than star-sized: a star
                    column grows past its share when a child's minimum desired
                    width demands it, and the controller DataGrid did exactly
                    that, squeezing this column until its content was clipped
                    by the ScrollViewer.
                -->
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="446" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <!--
                        Auto rather than * so the controller card hugs its rows.
                        As * it stretched to full height and left a large blank
                        white void under a single controller.
                    -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="桥接服务" Foreground="#667085" FontSize="12" />
                            <Border x:Name="ServicePill" Style="{StaticResource StatusPill}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock x:Name="ServiceStatusText" Text="检查中" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="USB/IP 驱动" Foreground="#667085" FontSize="12" />
                            <Border x:Name="UsbipPill" Style="{StaticResource StatusPill}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock x:Name="UsbipStatusText" Text="检查中" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HidHide" Foreground="#667085" FontSize="12" />
                            <Border x:Name="HidHidePill" Style="{StaticResource StatusPill}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock x:Name="HidHideStatusText" Text="检查中" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="核心版本" Foreground="#667085" FontSize="12" />
                            <Border x:Name="CorePill" Style="{StaticResource StatusPill}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock x:Name="CoreStatusText" Text="检查中" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="68" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DualSense 手柄" FontSize="18" FontWeight="SemiBold" Foreground="#172B4D" />
                                <TextBlock x:Name="ControllerCountText" Text="正在扫描..." FontSize="12"
                                           Foreground="#55647B" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                    Padding="13,7" VerticalAlignment="Center"
                                    Click="BluetoothSettings_Click" Content="蓝牙设置" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="ControllerGrid"
                                      MinHeight="112" MaxHeight="304"
                                      ItemsSource="{Binding Controllers}"
                                      SelectionChanged="ControllerGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="手柄" Binding="{Binding Name}" Width="1.5*" MinWidth="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="蓝牙地址" Binding="{Binding Address}" Width="1.5*" MinWidth="150"
                                                        ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTemplateColumn Header="蓝牙" Width="0.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="State" CornerRadius="6" Padding="9,4"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="#FEE2E2">
                                                    <TextBlock x:Name="StateText" Text="{Binding BluetoothStatus}" Foreground="#B42318"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                        <Setter TargetName="State" Property="Background" Value="#DCFCE7" />
                                                        <Setter TargetName="StateText" Property="Foreground" Value="#16794B" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="注册" Binding="{Binding RegistrationStatus}" Width="0.8*"
                                                        ElementStyle="{StaticResource GridCellText}" />
                                    <DataGridTemplateColumn Header="虚拟 USB" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="UsbState" CornerRadius="6" Padding="9,4"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="#EEF2F7">
                                                    <TextBlock x:Name="UsbStateText" Text="{Binding VirtualStatus}" Foreground="#596780"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                                        <Setter TargetName="UsbState" Property="Background" Value="#DBEAFE" />
                                                        <Setter TargetName="UsbStateText" Property="Foreground" Value="#1D4ED8" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="未发现 DualSense" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#344054" HorizontalAlignment="Center" />
                                <TextBlock Text="按住 Create + PS 进入配对模式，然后在 Windows 蓝牙设置中添加"
                                           Foreground="#55647B" FontSize="12" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                        <!--
                            Border.CornerRadius clips only what the Border draws
                            itself, not its children, so a plain Grid here
                            painted square corners over the card's rounded
                            bottom. Carry the matching radius and a hairline.
                        -->
                        <Border Grid.Row="2" Background="#F7F9FC" CornerRadius="0,0,15,15"
                                BorderThickness="0,1,0,0" BorderBrush="#EDF0F5" Margin="1,0,1,1" />
                        <Grid Grid.Row="2" Margin="1,1,1,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="20,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="模拟型号" FontSize="12" Foreground="#55647B" Margin="2,0,0,4" />
                                <ComboBox x:Name="ProfileCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="自动识别" Tag="auto" />
                                    <ComboBoxItem Content="DualSense" Tag="ds5" />
                                    <ComboBoxItem Content="DualSense Edge" Tag="dse" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="USB 端口" FontSize="12" Foreground="#55647B" Margin="2,0,0,4" />
                                <ComboBox x:Name="PortCombo" SelectedIndex="0" MinWidth="100">
                                    <ComboBoxItem Content="自动" Tag="auto" />
                                    <ComboBoxItem Content="端口 0" Tag="0" />
                                    <ComboBoxItem Content="端口 1" Tag="1" />
                                    <ComboBoxItem Content="端口 2" Tag="2" />
                                    <ComboBoxItem Content="端口 3" Tag="3" />
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="DetachButton" Grid.Column="3" Style="{StaticResource DangerButton}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    Content="取消注册" Click="Detach_Click" />
                            <Button x:Name="AttachButton" Grid.Column="4" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Center" Margin="0,0,20,0"
                                    Content="注册并连接" Click="Attach_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="20,16"
                        Background="#F0F7FF" BorderBrush="#D7E8FF">
                    <StackPanel>
                        <TextBlock Text="连接提示" FontSize="15" FontWeight="SemiBold" Foreground="#174EA6" />
                        <!-- Steps run across the card; stacked vertically they left the note stranded. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#D8E7FF" VerticalAlignment="Center">
                                    <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="#174EA6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="按 PS 键唤醒手柄" Margin="9,0,0,0" FontSize="13"
                                           Foreground="#38506F" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#D8E7FF" VerticalAlignment="Center">
                                    <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="#174EA6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="蓝牙状态变为“在线”" Margin="9,0,0,0" FontSize="13"
                                           Foreground="#38506F" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#D8E7FF" VerticalAlignment="Center">
                                    <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="#174EA6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="注册后自动创建虚拟 USB" Margin="9,0,0,0" FontSize="13"
                                           Foreground="#38506F" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#D3E3FA" Margin="0,14,0,12" />
                        <TextBlock Text="虚拟 USB 建立后可在 joy.cpl 中验证按键；自适应扳机和触觉音频由支持 DualSense 的游戏直接驱动。"
                                   TextWrapping="Wrap" Foreground="#4A6180" FontSize="13" LineHeight="21" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="快速操作" FontSize="18" FontWeight="SemiBold" Foreground="#172B4D" />
                        <TextBlock Text="安装修复版核心后，服务会自动恢复已注册手柄。"
                                   TextWrapping="Wrap" Foreground="#55647B" FontSize="12" Margin="0,7,0,16" />
                        <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}"
                                Content="安装 / 更新 vDS" Click="Update_Click" Margin="0,0,0,9" />
                        <Button x:Name="StartServiceButton" Style="{StaticResource SecondaryButton}"
                                Content="启动桥接服务" Click="StartService_Click" Margin="0,0,0,9" />
                        <Button Style="{StaticResource SecondaryButton}" Content="打开手柄测试"
                                Click="GameControllers_Click" Margin="0,0,0,9" />
                        <Button Style="{StaticResource SecondaryButton}" Content="查看服务日志"
                                Click="OpenLog_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        Background="#F4F8FF" BorderBrush="#CFE0FF">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="桌面音频触觉" FontSize="17" FontWeight="SemiBold"
                                           Foreground="#172B4D" />
                                <TextBlock Text="捕获播放设备声音，通过蓝牙兼容模式实时驱动左右马达"
                                           Foreground="#667085" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="AudioHapticsAutoStartCheckBox" Grid.Column="1"
                                      Content="启动时自动开启" FontSize="12" Foreground="#475467"
                                      VerticalAlignment="Center"
                                      Checked="AudioHapticsAutoStart_Changed"
                                      Unchecked="AudioHapticsAutoStart_Changed" />
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AudioHapticsToggleButton" Style="{StaticResource PrimaryButton}"
                                    Content="开始音频触觉" Click="AudioHapticsToggle_Click" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,10"
                                    Content="刷新设备" Click="AudioHapticsRefreshDevices_Click" />
                        </Grid>
                        <!--
                            Meters live directly under the transport controls:
                            below the Expanders they scrolled out of view the
                            moment either advanced panel was opened, which is
                            exactly when live feedback is needed.
                        -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="输入电平" Foreground="{StaticResource TextTertiary}" FontSize="12" />
                                <ProgressBar x:Name="AudioHapticsInputMeter" Style="{StaticResource MeterBar}"
                                             Foreground="#8FA3BF" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="触觉输出" Foreground="{StaticResource TextTertiary}" FontSize="12" />
                                <ProgressBar x:Name="AudioHapticsOutputMeter" Style="{StaticResource MeterBar}"
