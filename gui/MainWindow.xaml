                        <Border x:Name="AudioHapticsHeadroomPanel" Visibility="Collapsed"
                                Background="#FEF6E7" BorderBrush="#F3D9A4" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="当前增益偏高，波形可能被削波"
                                           FontWeight="SemiBold" Foreground="#8A5A00" FontSize="12" />
