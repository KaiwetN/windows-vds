                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="右扳机 (R2)" Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox x:Name="EffectsRightTriggerCombo" SelectionChanged="Effects_ValueChanged">
                                    <ComboBoxItem Tag="follow" Content="跟随游戏" />
                                    <ComboBoxItem Tag="off" Content="关闭效果" />
                                    <ComboBoxItem Tag="resistance" Content="连续阻力" />
                                    <ComboBoxItem Tag="endstop" Content="末段变硬" />
                                    <ComboBoxItem Tag="semiauto" Content="半自动枪械" />
                                    <ComboBoxItem Tag="heavy" Content="重型武器" />
                                    <ComboBoxItem Tag="vibrate" Content="高频震动" />
                                    <ComboBoxItem Tag="bow" Content="弓弦" />
                                    <ComboBoxItem Tag="gallop" Content="奔马" />
                                    <ComboBoxItem Tag="machine" Content="机枪" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="扳机强度" Foreground="#344054" FontSize="12" />
                            <TextBlock x:Name="EffectsTriggerStrengthText" Grid.Column="1"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12" />
