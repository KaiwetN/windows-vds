                                <TextBlock Text="声道映射" Foreground="#667085" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox x:Name="AudioHapticsChannelModeCombo" SelectionChanged="AudioHapticsSetting_ValueChanged">
                                    <ComboBoxItem Tag="stereo" Content="立体声左右分离" />
                                    <ComboBoxItem Tag="mono" Content="单声道双马达" />
                                    <ComboBoxItem Tag="left" Content="仅左声道驱动双马达" />
                                    <ComboBoxItem Tag="right" Content="仅右声道驱动双马达" />
                                    <ComboBoxItem Tag="swap" Content="交换左右马达" />
                                </ComboBox>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="立体声宽度" Foreground="#344054" FontSize="12" />
                                    <TextBlock x:Name="AudioHapticsWidthText" Grid.Column="1" Foreground="#2563EB" FontSize="12" />
                                </Grid>
                                <Slider x:Name="AudioHapticsWidthSlider" Minimum="0" Maximum="200" TickFrequency="5"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="噪声门限" Foreground="#344054" FontSize="12" />
                                    <TextBlock x:Name="AudioHapticsGateText" Grid.Column="1" Foreground="#2563EB" FontSize="12" />
                                </Grid>
                                <Slider x:Name="AudioHapticsGateSlider" Minimum="-80" Maximum="-20" TickFrequency="1"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="压缩比" Foreground="#344054" FontSize="12" />
                                    <TextBlock x:Name="AudioHapticsCompressionText" Grid.Column="1" Foreground="#2563EB" FontSize="12" />
                                </Grid>
                                <Slider x:Name="AudioHapticsCompressionSlider" Minimum="1" Maximum="12" TickFrequency="0.5"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                                <!-- Each slider gets its own label and readout; one shared "4 / 120 ms" caption made it impossible to tell which slider you were dragging. -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="起音" Foreground="{StaticResource TextTertiary}" FontSize="12" />
                                        <TextBlock x:Name="AudioHapticsAttackText" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
                                        <Slider x:Name="AudioHapticsAttackSlider" Minimum="1" Maximum="80" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="释放" Foreground="{StaticResource TextTertiary}" FontSize="12" />
                                        <TextBlock x:Name="AudioHapticsReleaseText" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,3,0,0" />
                                        <Slider x:Name="AudioHapticsReleaseSlider" Minimum="20" Maximum="600" TickFrequency="10"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="左马达" Foreground="#667085" FontSize="12" />
                                        <TextBlock x:Name="AudioHapticsLeftText" Foreground="#2563EB" FontSize="12" Margin="0,3,0,0" />
                                        <Slider x:Name="AudioHapticsLeftSlider" Minimum="0" Maximum="200" TickFrequency="5"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="右马达" Foreground="#667085" FontSize="12" />
                                        <TextBlock x:Name="AudioHapticsRightText" Foreground="#2563EB" FontSize="12" Margin="0,3,0,0" />
                                        <Slider x:Name="AudioHapticsRightSlider" Minimum="0" Maximum="200" TickFrequency="5"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="输出上限" Foreground="#344054" FontSize="12" />
                                    <TextBlock x:Name="AudioHapticsCeilingText" Grid.Column="1" Foreground="#2563EB" FontSize="12" />
                                </Grid>
                                <Slider x:Name="AudioHapticsCeilingSlider" Minimum="10" Maximum="100" TickFrequency="1"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                                <CheckBox x:Name="AudioHapticsInvertRightCheckBox" Content="反相右马达"
                                          Margin="0,8,0,0" Foreground="#475467"
                                          Checked="AudioHapticsSetting_ValueChanged"
                                          Unchecked="AudioHapticsSetting_ValueChanged" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="音频混音 / 原生音圈 " Margin="0,10,0,0" Foreground="#344054">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="音圈增益" Foreground="#344054" FontSize="12" />
                                <TextBlock x:Name="AudioHapticsVoiceCoilGainText" Foreground="#2563EB" FontSize="12" Margin="0,3,0,0" />
                                <Slider x:Name="AudioHapticsVoiceCoilGainSlider" Minimum="0.1" Maximum="10" TickFrequency="0.1"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                                <TextBlock Text="建议 1.0 – 5.0" Foreground="#5D6B80" FontSize="12" Margin="0,2,0,0" />

                                <TextBlock Text="声道映射（源声道 → 马达）" Foreground="#344054" FontSize="12" Margin="0,12,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,7,0">
                                        <TextBlock Text="左马达来源" Foreground="#667085" FontSize="12" />
                                        <ComboBox x:Name="AudioHapticsLeftSourceCombo" Margin="0,3,0,0"
                                                  SelectionChanged="AudioHapticsSetting_ValueChanged">
                                            <ComboBoxItem Tag="0" Content="左声道" />
                                            <ComboBoxItem Tag="1" Content="右声道" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="右马达来源" Foreground="#667085" FontSize="12" />
                                        <ComboBox x:Name="AudioHapticsRightSourceCombo" Margin="0,3,0,0"
                                                  SelectionChanged="AudioHapticsSetting_ValueChanged">
                                            <ComboBoxItem Tag="0" Content="左声道" />
                                            <ComboBoxItem Tag="1" Content="右声道" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="均衡器" Foreground="#344054" FontSize="12" Margin="0,12,0,4" />
                                <ComboBox x:Name="AudioHapticsEqModeCombo" SelectionChanged="AudioHapticsSetting_ValueChanged">
                                    <ComboBoxItem Tag="off" Content="关闭" />
                                    <ComboBoxItem Tag="band3" Content="3 段均衡" />
                                    <ComboBoxItem Tag="band6" Content="6 段均衡" />
                                </ComboBox>
                                <TextBlock Text="触觉通道为 3 kHz 采样，约 1.5 kHz 以上的频段对振动无效。"
                                           TextWrapping="Wrap" Foreground="#5D6B80" FontSize="12" Margin="0,4,0,0" />

                                <StackPanel x:Name="AudioHapticsEq3Panel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="AudioHapticsEq3Band1Text" Foreground="#2563EB" FontSize="12" />
                                    <Slider x:Name="AudioHapticsEq3Band1Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                            ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    <TextBlock x:Name="AudioHapticsEq3Band2Text" Foreground="#2563EB" FontSize="12" Margin="0,6,0,0" />
                                    <Slider x:Name="AudioHapticsEq3Band2Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                            ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    <TextBlock x:Name="AudioHapticsEq3Band3Text" Foreground="#2563EB" FontSize="12" Margin="0,6,0,0" />
                                    <Slider x:Name="AudioHapticsEq3Band3Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                            ValueChanged="AudioHapticsSetting_ValueChanged" />
                                </StackPanel>

                                <!-- Two columns: six stacked band rows were taller than the whole viewport. -->
                                <Grid x:Name="AudioHapticsEq6Panel" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock x:Name="AudioHapticsEq6Band1Text" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                        <Slider x:Name="AudioHapticsEq6Band1Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock x:Name="AudioHapticsEq6Band2Text" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                        <Slider x:Name="AudioHapticsEq6Band2Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock x:Name="AudioHapticsEq6Band3Text" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                        <Slider x:Name="AudioHapticsEq6Band3Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock x:Name="AudioHapticsEq6Band4Text" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                        <Slider x:Name="AudioHapticsEq6Band4Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock x:Name="AudioHapticsEq6Band5Text" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                        <Slider x:Name="AudioHapticsEq6Band5Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock x:Name="AudioHapticsEq6Band6Text" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                        <Slider x:Name="AudioHapticsEq6Band6Slider" Minimum="-20" Maximum="20" TickFrequency="1"
                                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="AudioHapticsStatusText" Text="选择播放设备后开始；设置会自动保存。"
                                   TextWrapping="Wrap" Foreground="#667085" FontSize="12" LineHeight="18" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="扳机与灯效" FontSize="17" FontWeight="SemiBold" Foreground="#172B4D" />
