                            <Slider x:Name="AudioHapticsSpeakerVolumeSlider" Minimum="0" Maximum="100"
                                    TickFrequency="5" Margin="0,6,0,0"
                                    ValueChanged="AudioHapticsSetting_ValueChanged" />
