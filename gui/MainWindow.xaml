                                           LineHeight="18" Margin="0,4,0,8" />
                                <Button Content="恢复推荐值" Style="{StaticResource SecondaryButton}"
                                        Padding="12,7" HorizontalAlignment="Left"
                                        Click="AudioHapticsRestoreHeadroom_Click" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="预设" Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,12,0,4" />
                        <ComboBox x:Name="AudioHapticsPresetCombo" SelectionChanged="AudioHapticsPreset_SelectionChanged">
                            <ComboBoxItem Tag="balanced" Content="平衡（推荐）" />
                            <ComboBoxItem Tag="bass" Content="低频冲击" />
                            <ComboBoxItem Tag="detail" Content="细节 / 节奏" />
                            <ComboBoxItem Tag="cinema" Content="电影宽动态" />
                            <ComboBoxItem Tag="custom" Content="自定义" />
                        </ComboBox>

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="触觉强度" Foreground="#344054" FontSize="12" />
                            <TextBlock x:Name="AudioHapticsStrengthText" Grid.Column="1" Foreground="#2563EB" FontSize="12" />
                        </Grid>
                        <Slider x:Name="AudioHapticsStrengthSlider" Minimum="0" Maximum="220" TickFrequency="5"
                                ValueChanged="AudioHapticsSetting_ValueChanged" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入增益" Foreground="#344054" FontSize="12" />
                            <TextBlock x:Name="AudioHapticsGainText" Grid.Column="1" Foreground="#2563EB" FontSize="12" />
                        </Grid>
                        <Slider x:Name="AudioHapticsGainSlider" Minimum="-24" Maximum="24" TickFrequency="1"
                                ValueChanged="AudioHapticsSetting_ValueChanged" />

                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,7,0">
                                <TextBlock Text="低切" Foreground="#667085" FontSize="12" />
                                <TextBlock x:Name="AudioHapticsLowCutText" Foreground="#2563EB" FontSize="12" Margin="0,3,0,0" />
                                <Slider x:Name="AudioHapticsLowCutSlider" Minimum="10" Maximum="500" TickFrequency="10"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="高切" Foreground="#667085" FontSize="12" />
                                <TextBlock x:Name="AudioHapticsHighCutText" Foreground="#2563EB" FontSize="12" Margin="0,3,0,0" />
                                <Slider x:Name="AudioHapticsHighCutSlider" Minimum="60" Maximum="2000" TickFrequency="20"
                                        ValueChanged="AudioHapticsSetting_ValueChanged" />
                            </StackPanel>
                        </Grid>

                        <Expander Header="高级动态与声道控制" Margin="0,13,0,0" Foreground="#263246">
