                                    <ComboBoxItem Tag="p2" Content="2 号位" />
                                    <ComboBoxItem Tag="p3" Content="3 号位" />
                                    <ComboBoxItem Tag="p4" Content="4 号位" />
                                    <ComboBoxItem Tag="all" Content="全部点亮" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="麦克风静音灯" Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,0,0,4" />
                                <ComboBox x:Name="EffectsMuteLedCombo" SelectionChanged="Effects_ValueChanged">
                                    <ComboBoxItem Tag="follow" Content="跟随游戏" />
                                    <ComboBoxItem Tag="off" Content="熄灭" />
                                    <ComboBoxItem Tag="on" Content="常亮" />
                                    <ComboBoxItem Tag="breath" Content="呼吸" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="EffectsForceCheckBox" Content="强制模式（覆盖游戏自己的设置）"
                                  Margin="0,12,0,0" FontSize="12" Foreground="#475467"
                                  Checked="Effects_ValueChanged" Unchecked="Effects_ValueChanged" />
                        <TextBlock x:Name="EffectsStatusText" Text="选择「跟随游戏」表示不干预对应功能。"
                                   TextWrapping="Wrap" Foreground="#667085" FontSize="12"
                                   LineHeight="18" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"
                        Background="#F8FAFF" BorderBrush="#D9E3FF">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="音频 / 震动缓冲" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#172B4D" />
                            <TextBlock x:Name="AudioBufferValueText" Grid.Column="1" Text="32 ms · 3 块"
                                       Foreground="#2563EB" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="越低延迟越小；出现震动断续或声音爆裂时，向右增加一格。"
                                   TextWrapping="Wrap" Foreground="#667085" FontSize="12"
                                   LineHeight="18" Margin="0,7,0,10" />
                        <Slider x:Name="AudioBufferSlider" Minimum="1" Maximum="48" Value="3"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="AudioBufferSlider_ValueChanged" />
                        <Grid Margin="0,2,0,10">
                            <TextBlock Text="11 ms" Foreground="#5D6B80" FontSize="12" />
                            <TextBlock Text="512 ms" Foreground="#5D6B80" FontSize="12"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AudioBufferStatusText" Text="等待读取服务设置"
                                       Foreground="#55647B" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="AudioBufferApplyButton" Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}" Padding="14,8"
                                    Content="立即应用" Click="AudioBufferApply_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,12" CornerRadius="12" Background="White"
                BorderBrush="#E5EAF1" BorderThickness="1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ActivityDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" />
                <TextBlock x:Name="ActivityText" Grid.Column="1" Text="正在初始化..."
                           Foreground="#596780" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                <TextBlock x:Name="LastRefreshText" Grid.Column="2" Text=""
                           Foreground="#5D6B80" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Background="#660B1220" Visibility="Collapsed">
            <Border Width="330" Padding="28" Background="White" CornerRadius="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="#2563EB" />
                    <TextBlock x:Name="BusyText" Text="正在处理..." FontSize="16" FontWeight="SemiBold"
                               Foreground="#263246" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="请不要关闭窗口" Foreground="#55647B" HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
