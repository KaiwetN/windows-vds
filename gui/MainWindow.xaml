                                    <ComboBoxItem Tag="resistance" Content="连续阻力" />
                                    <ComboBoxItem Tag="endstop" Content="末段变硬" />
                                    <ComboBoxItem Tag="semiauto" Content="半自动枪械" />
                                    <ComboBoxItem Tag="heavy" Content="重型武器" />
                                    <ComboBoxItem Tag="vibrate" Content="高频震动" />
                                    <ComboBoxItem Tag="bow" Content="弓弦" />
                                    <ComboBoxItem Tag="gallop" Content="奔马" />
                                    <ComboBoxItem Tag="machine" Content="机枪" />
